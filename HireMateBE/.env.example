# Copy to .env on the Oracle VM and fill in real values.
# Do NOT commit .env

MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Pass!
JWT_KEY=ChangeMe_HireMate_JWT_Key_AtLeast32Chars!

# Public URL of this API (Oracle public IP or domain)
API_PUBLIC_URL=http://YOUR_PUBLIC_IP:5080

# Frontend URL (Vercel/Netlify/local) — Vite uses port 3000 in this repo
FRONTEND_URL=http://localhost:3000

# Extra CORS origins (optional)
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:5173

# VNPay sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg/)
# Map vào ASP.NET: VnPay__Enabled / VnPay__TmnCode / VnPay__HashSecret
# VnPay__Enabled=true
# VnPay__TmnCode=
# VnPay__HashSecret=
# VnPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VnPay__ReturnUrl=https://localhost:7080/api/Billing/vnpay-return
# VnPay__IpnUrl=https://localhost:7080/api/Billing/vnpay-ipn
# VnPay__FrontendReturnUrl=http://localhost:3000/billing-result
