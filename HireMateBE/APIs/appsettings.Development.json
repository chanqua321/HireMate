{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "EmailSettings": {
    "ExposeDevTokens": true,
    "RequireEmailConfirmation": true,
    "FrontendUrl": "http://localhost:3000",
    "ApiPublicUrl": "https://localhost:7080"
  },
  "Ai": {
    "Enabled": true,
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-5.6-luna",
    "ApiKey": "",
    "TimeoutSeconds": 60
  },
  "PayOS": {
    "Enabled": true,
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ApiBaseUrl": "https://api-merchant.payos.vn",
    "ReturnUrl": "http://localhost:3000/billing-result?status=success",
    "CancelUrl": "http://localhost:3000/billing-result?status=cancel",
    "FrontendReturnUrl": "http://localhost:3000/billing-result"
  },
  "Cors": {
    "Origins": [ "*" ]
  },
  "Swagger": {
    "Enabled": true
  }
}
